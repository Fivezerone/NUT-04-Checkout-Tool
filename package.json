{
  "name": "nut-04-checkout-tool",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build:ext": "node -e \"const fs=require('fs'); fs.cpSync('src/extension', 'dist', {recursive: true, filter: (src) => !src.endsWith('.xlsx')})\"",
    "build:ui": "vite build",
    "build:web": "cd webpage && node build.js",
    "build": "npm run build:ui && npm run build:ext && npm run build:web && node scripts/prepare-deploy.js",
    "dev": "vite"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-switch": "1.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "esbuild": "^0.28.1",
    "idb": "^8.0.3",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "preact": "^10.29.7",
    "react-day-picker": "8.10.1",
    "react-hook-form": "7.55.0",
    "react-resizable-panels": "2.1.7",
    "react-router": "7.13.0",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "vite": "^6.3.5"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
