{
  "name": "nut-04-checkout-tool",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build:db": "node scripts/build-db.mjs",
    "build:ext": "node scripts/build-sw-client.mjs && node scripts/build-ext.mjs",
    "build:ui": "vite build",
    "build": "npm run build:db && npm run build:ui && npm run build:ext",
    "check:manifest": "node scripts/check-manifest-globals.mjs",
    "dev": "vite",
    "test": "vitest run src/ui/src/app/__tests__",
    "test:watch": "vitest src/ui/src/app/__tests__",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "node scripts/check-no-secrets-tracked.mjs && npm run check:manifest && node --check src/extension/content.js && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm audit --audit-level=high",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-switch": "1.1.3",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "esbuild": "^0.28.1",
    "idb": "^8.0.3",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "preact": "^10.29.7",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.1.12",
    "@types/chrome": "^0.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.1.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
