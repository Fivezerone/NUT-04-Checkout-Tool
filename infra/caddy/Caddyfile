# infra/caddy/Caddyfile
# NUT-04 Checkout Tool — API Gateway (Caddy)

(gateway_routes) {
    # Health probes for Docker Compose healthcheck
    respond /healthz 200
    respond /health 200

    # Clean redirects for CAD entrypoints
    redir /cad /cad/ permanent
    redir /cad.html /cad/ permanent

    # API → PostgREST
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy postgrest:3000
    }

    # Auth → Keycloak
    handle /auth/* {
        reverse_proxy keycloak:8080
    }

    # CAD → Clinic Admin Dashboard Nginx container
    handle /cad/* {
        uri strip_prefix /cad
        reverse_proxy cad:8080
    }

    # Fallback
    respond 404
}

http://:8080 {
    import gateway_routes
}

:8443 {
    tls internal
    import gateway_routes
}
