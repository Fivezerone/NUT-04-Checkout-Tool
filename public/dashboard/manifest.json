{
  "manifest_version": 3,
  "name": "NutriScore Checkout Tool (Kenya)",
  "version": "1.1.0",
  "description": "Real-time NutriScore grades with disease-specific dietary flags for Naivas and Carrefour Kenya.",
  "permissions": [],
  "externally_connectable": {
    "matches": [
      "https://nutriscore.co.ke/*",
      "https://*.nutriscore.co.ke/*"
    ]
  },
  "host_permissions": [
    "*://*.naivas.online/*",
    "*://*.naivas.co.ke/*",
    "*://*.carrefour.ke/*",
    "*://*.carrefourkenya.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.naivas.online/*",
        "*://*.naivas.co.ke/*"
      ],
      "js": [
        "adapters/grade-colors.js",
        "adapters/shared-ui.js",
        "adapters/naivas.js",
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://*.carrefour.ke/*",
        "*://*.carrefourkenya.com/*"
      ],
      "js": [
        "adapters/grade-colors.js",
        "adapters/shared-ui.js",
        "adapters/carrefour.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "48": "icons/icon.svg",
      "128": "icons/icon.svg"
    }
  },
  "options_page": "dashboard.html",
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
