{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutriscore.co.ke/schemas/claims/v1",
  "title": "NutriScore canonical access claims",
  "type": "object",
  "additionalProperties": false,
  "required": ["sub", "sid", "app_role", "lic_ok", "ver"],
  "properties": {
    "sub": { "type": "string", "format": "uuid" },
    "sid": { "type": "string" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "app_role": {
      "type": "string",
      "enum": [
        "super_admin",
        "tenant_admin",
        "writing_clinician",
        "viewing_dietician",
        "compliance_auditor",
        "commercial_stakeholder",
        "patient"
      ]
    },
    "lic_ok": { "type": "boolean" },
    "auditor_scope": { "type": "string", "enum": ["tenant", "platform"] },
    "acr": {
      "type": ["string", "integer"],
      "enum": [
        0,
        1,
        2,
        3,
        "0",
        "1",
        "2",
        "3",
        "loa0",
        "loa1",
        "loa2",
        "loa3",
        "aal1",
        "aal2",
        "aal3"
      ]
    },
    "amr": {
      "type": "array",
      "items": { "type": "string" }
    },
    "iss": { "type": "string" },
    "aud": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "exp": { "type": "integer" },
    "nbf": { "type": "integer" },
    "iat": { "type": "integer" },
    "jti": { "type": "string" },
    "ver": { "type": "integer", "const": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "app_role": { "const": "compliance_auditor" } } },
      "then": { "required": ["auditor_scope"] },
      "else": { "not": { "required": ["auditor_scope"] } }
    }
  ]
}
