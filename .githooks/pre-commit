#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# NUT-04 Pre-Commit Hook
# Runs on every `git commit`. Enforces:
#   1. Prettier formatting on staged files
#   2. ESLint on staged JS/TS files
#   3. Gitleaks secret scanning on staged diffs
#   4. db.js rebuild if db.ts changed
# ─────────────────────────────────────────────────────────────────────────────

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo ""
echo "${YELLOW}═══════════════════════════════════════════════════${NC}"
echo "${YELLOW}  NUT-04 Pre-Commit Quality Gates${NC}"
echo "${YELLOW}═══════════════════════════════════════════════════${NC}"
echo ""

# Collect staged files (exclude deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  echo "${GREEN}✓ No staged files to check.${NC}"
  exit 0
fi

# ─── Gate 1: Prettier Formatting ──────────────────────────────────────────────
FORMAT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|ts|tsx|json|css|md|html)$' || true)

if [ -n "$FORMAT_FILES" ]; then
  echo "${YELLOW}▸ Gate 1/4: Checking formatting (Prettier)...${NC}"
  echo "$FORMAT_FILES" | xargs npx prettier --check --ignore-unknown 2>/dev/null
  if [ $? -ne 0 ]; then
    echo ""
    echo "${RED}✗ Formatting check failed.${NC}"
    echo "  Run: npx prettier --write <files>"
    exit 1
  fi
  echo "${GREEN}  ✓ All staged files formatted correctly.${NC}"
else
  echo "${GREEN}▸ Gate 1/4: No formattable files staged. Skipping.${NC}"
fi
echo ""

# ─── Gate 2: ESLint ───────────────────────────────────────────────────────────
LINT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|ts|tsx)$' || true)

if [ -n "$LINT_FILES" ]; then
  echo "${YELLOW}▸ Gate 2/4: Linting staged files (ESLint)...${NC}"
  echo "$LINT_FILES" | xargs npx eslint --no-warn-ignored --quiet 2>/dev/null
  if [ $? -ne 0 ]; then
    echo ""
    echo "${RED}✗ Lint check failed. Fix errors above before committing.${NC}"
    exit 1
  fi
  echo "${GREEN}  ✓ No lint errors.${NC}"
else
  echo "${GREEN}▸ Gate 2/4: No lintable files staged. Skipping.${NC}"
fi
echo ""

# ─── Gate 3: Gitleaks Secret Scan ─────────────────────────────────────────────
echo "${YELLOW}▸ Gate 3/4: Scanning for secrets (Gitleaks)...${NC}"

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --config .gitleaks.toml --verbose
  if [ $? -ne 0 ]; then
    echo ""
    echo "${RED}✗ Gitleaks detected secrets in staged changes!${NC}"
    echo "  Remove the secrets and try again."
    exit 1
  fi
  echo "${GREEN}  ✓ No secrets detected.${NC}"
else
  echo "${YELLOW}  ⚠ Gitleaks not installed locally. Skipping.${NC}"
  echo "    Install: https://github.com/gitleaks/gitleaks#installing"
fi
echo ""

# ─── Gate 4: Rebuild db.js if db.ts Changed ───────────────────────────────────
if echo "$STAGED_FILES" | grep -q "src/ui/src/app/lib/db.ts"; then
  echo "${YELLOW}▸ Gate 4/4: db.ts changed — rebuilding db.js...${NC}"

  npm run build:db
  if [ $? -ne 0 ]; then
    echo "${RED}✗ npm run build:db failed. Commit aborted.${NC}"
    exit 1
  fi

  if git diff --name-only | grep -q "src/extension/db.js"; then
    echo "  Auto-staging updated db.js..."
    git add src/extension/db.js
  fi
  echo "${GREEN}  ✓ db.js rebuilt and staged.${NC}"
else
  echo "${GREEN}▸ Gate 4/4: db.ts unchanged. Skipping db.js rebuild.${NC}"
fi

echo ""
echo "${GREEN}═══════════════════════════════════════════════════${NC}"
echo "${GREEN}  All gates passed. Committing...${NC}"
echo "${GREEN}═══════════════════════════════════════════════════${NC}"
echo ""

exit 0
