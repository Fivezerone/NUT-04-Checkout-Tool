# infra/caddy/Caddyfile
# NUT-04 Checkout Tool — API Gateway (Caddy)

(gateway_routes) {
    # Health probes for Docker Compose healthcheck
    respond /healthz 200
    respond /health 200

    # Clean redirects for CAD and Auth entrypoints
    redir /cad /cad/ permanent
    redir /cad.html /cad/ permanent
    redir /auth /auth/ permanent
    redir /admin /auth/admin/ permanent
    redir /admin/* /auth/admin/ permanent

    # Dedicated Node.js API service (Telemetry Gateway, Consent Register, BFF)
    handle /v1/* {
        reverse_proxy api:4000
    }
    handle /api/v1/* {
        uri strip_prefix /api
        reverse_proxy api:4000
    }

    # API → PostgREST
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy postgrest:3000
    }

    # Auth → Keycloak
    handle /auth/* {
        reverse_proxy keycloak:8080
    }

    # CAD → Clinic Admin Dashboard Nginx container
    handle /cad/* {
        uri strip_prefix /cad
        reverse_proxy cad:8080
    }

    # Fallback
    respond 404
}

http://:8080 {
    import gateway_routes
}

:8443 {
    tls internal
    import gateway_routes
}
