# ── NUT-04 Checkout Tool — Environment Variables ────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit a .env file containing real secrets to source control.
#
# STAGE A (A-10): Supabase credentials removed (decision 7, keys rotated).
#   Replaced with Docker Compose stack endpoints.
#
# After copying: docker compose --profile dev up --build
# ────────────────────────────────────────────────────────────────────────────

# ── API Gateway (Caddy) ──────────────────────────────────────────────────────
VITE_API_URL=https://localhost:8443/api

# ── Keycloak OIDC ────────────────────────────────────────────────────────────
VITE_OIDC_ISSUER=https://localhost:8443/auth/realms/nutriscore
VITE_OIDC_CLIENT_ID=nutriscore-extension

# ── Clinical Retention (Decision 4) ─────────────────────────────────────────
# Clinician views and server storage: Kenyan health-data retention (20 years default)
# 3-month device purge is enforced client-side only; never run server-side.
CLINICAL_RETENTION_YEARS=20

# ── Feature Flags ────────────────────────────────────────────────────────────
# Payments and subscriptions are decommissioned (Decision 6).
PAYMENTS_ENABLED=false

# ── Postgres (populated by Docker secrets in compose; override for local psql) ──
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=nutriscore
# DB_USER=nutriscore_app

# ── Catalog Signing (CI only — private key never stored here) ────────────────
# CATALOG_SIGNING_KEY=  <-- JWK JSON; set in GitHub Actions secret only

# ── Keycloak Admin (compose only — do not expose externally) ─────────────────
# KC_BOOTSTRAP_ADMIN_USERNAME=admin
# KC_BOOTSTRAP_ADMIN_PASSWORD=  <-- set in .secrets/keycloak_admin_password
