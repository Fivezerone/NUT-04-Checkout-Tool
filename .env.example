# ─── Supabase Project Credentials ─────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# Get these from: https://supabase.com/dashboard/project/<project-ref>/settings/api
#
# IMPORTANT:
#   - VITE_SUPABASE_URL   → the Project URL  (e.g. https://xxxx.supabase.co)
#   - VITE_SUPABASE_ANON_KEY → the anon/public key (safe to expose in client code)
#   - NEVER commit the Service Role Key to source control.
#   - The Service Role Key belongs ONLY in Supabase Edge Function secrets.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
